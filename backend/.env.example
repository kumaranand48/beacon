PORT=3001

# AWS / DynamoDB (leave blank to auto-enable mock mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_PREFIX=beacon_

# GA4 Data API
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Auth (backend token verification)
FIREBASE_PROJECT_ID=

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Email allowlist (comma-separated, empty = allow all authenticated users)
ALLOWED_EMAILS=

# Force mock mode (auto-enabled when AWS creds are missing)
USE_MOCK_DATA=true
